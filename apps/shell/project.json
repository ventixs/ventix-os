{
  "name": "shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/shell/src",
  "tags": ["scope:shell"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/shell",
        "index": "apps/shell/src/index.html",
        "browser": "apps/shell/src/main.ts",
        "polyfills": [],
        "tsConfig": "apps/shell/tsconfig.app.json",
        "assets": [{ "glob": "**/*", "input": "apps/shell/public", "output": "/" }],
        "styles": ["apps/shell/src/styles.css"],
        "scripts": []
      },
      "configurations": {
        "production": { "budgets": [{ "type": "initial", "maximumWarning": "700kb", "maximumError": "1mb" }] },
        "development": { "optimization": false, "sourceMap": true, "namedChunks": true }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "continuous": true,
      "options": { "buildTarget": "shell:build", "port": 4200 },
      "configurations": {
        "production": { "buildTarget": "shell:build:production" },
        "development": { "buildTarget": "shell:build:development" }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
