{
  "name": "hello",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/plugins/hello/src",
  "tags": ["scope:plugin"],
  "targets": {
    "deploy-dev": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "mkdir -p apps/shell/public/plugins/com.demo.hello",
          "cp libs/plugins/hello/src/main.js apps/shell/public/plugins/com.demo.hello/index.js",
          "cp libs/plugins/hello/ventix.plugin.json apps/shell/public/plugins/com.demo.hello/ventix.plugin.json"
        ],
        "parallel": false
      }
    }
  }
}
