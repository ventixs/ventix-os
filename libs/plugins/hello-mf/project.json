{
  "name": "hello-mf",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/plugins/hello-mf/src",
  "tags": ["scope:plugin"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/plugins/hello-mf",
        "command": "vite build"
      }
    },
    "deploy-dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "mkdir -p apps/shell/public/plugins/com.demo.hello-mf",
          "cp -r libs/plugins/hello-mf/dist/. apps/shell/public/plugins/com.demo.hello-mf/",
          "cp libs/plugins/hello-mf/ventix.plugin.json apps/shell/public/plugins/com.demo.hello-mf/ventix.plugin.json"
        ],
        "parallel": false
      }
    }
  }
}
